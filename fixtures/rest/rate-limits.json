{
  "fractional": {
    "headers": {
      "x-ratelimit-bucket": "fixture-shared-bucket",
      "x-ratelimit-limit": "3",
      "x-ratelimit-remaining": "0",
      "x-ratelimit-reset-after": "0.125",
      "x-ratelimit-reset": "1"
    }
  },
  "route_429": {
    "headers": {
      "x-ratelimit-bucket": "fixture-shared-bucket",
      "x-ratelimit-limit": "3",
      "x-ratelimit-remaining": "2",
      "x-ratelimit-reset-after": "0.125",
      "retry-after": "0.375",
      "x-ratelimit-scope": "shared"
    },
    "body": {
      "message": "You are being rate limited.",
      "retry_after": 0.25,
      "global": false
    }
  },
  "global_429": {
    "headers": {
      "retry-after": "0.5",
      "x-ratelimit-global": "true",
      "x-ratelimit-scope": "global"
    },
    "body": {
      "message": "You are being rate limited.",
      "retry_after": 0.25,
      "global": true
    }
  }
}
